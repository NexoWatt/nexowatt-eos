{
  "common": {
    "name": "nexowatt-ui",
    "version": "1.0.21",
    "news": {
      "1.0.21": {
        "en": "Clarify zero-export setup in a full-width panel, preserve PV inverter measurement mappings, and restrict SmartHome configuration in its own area to installers and administrators.",
        "de": "Nulleinspeisung in voller Breite übersichtlich einrichten, PV-Wechselrichter-Messzuordnungen erhalten und SmartHome-Konfiguration im eigenen Bereich auf Installateur und Admin beschränken."
      },
      "1.0.20": {
        "en": "Allow verified storage support for zero-export charge-point grid limits while retaining storage protection, household priority and electrical limits; restore heating-rod tariff operation without an explicit cap.",
        "de": "Bestätigte Speicherunterstützung bei LP-Netzgrenzen der Nulleinspeisung, mit Speicherschutz, Hauslast-Vorrang und elektrischen Grenzen; Heizstab-Tarifbetrieb ohne ausdrückliche Begrenzung korrigiert."
      },
      "1.0.19": {
        "en": "Zero-export per-charge-point grid share instead of a total Boost cap: measured PV adds on top, Auto minimum plus PV, tariff and target planning within limits.",
        "de": "Bei Nulleinspeisung Netzanteil je Ladepunkt statt Boost-Gesamtgrenze: gemessene PV zusätzlich, Auto mit Minimum plus PV, Tarif und Zeit-Ziel innerhalb der Grenzen."
      },
      "1.0.18": {
        "en": "Bounded zero-export PV charging hold and restart pause; per-charge-point Boost power cap with AC phase handling.",
        "de": "Begrenzte PV-Überbrückung und Wiederanlaufsperre bei Nulleinspeisung; Boost-Leistungsgrenze je Ladepunkt mit AC-Phasenwahl."
      },
      "1.0.17": {
        "en": "Coordinate bounded zero-export PV startup across charging, heating rods and directly controllable storage; preserve electrical limits and safe phase switching. Site commissioning remains required.",
        "de": "Nulleinspeise-PV-Anlauf für Ladepunkte, Heizstäbe und direkt regelbare Speicher zentral koordinieren; elektrische Grenzen und sichere Phasenumschaltung erhalten. Anlagenbezogene Inbetriebnahme bleibt erforderlich."
      },
      "1.0.16": {
        "en": "Integrate Microgrid setup, operation and metering into the EMS app with unified installation gating and protected active limits.",
        "de": "Microgrid-Einrichtung, Regelung und Zählerarchiv als gemeinsame EMS-App mit Installationsprüfung und geschützten aktiven Grenzen."
      },
      "1.0.15": {
        "en": "Transformer master with demand-based house limits, optional durable meter archives and operator billing drafts; fast exchanges and verified command acknowledgements.",
        "de": "Trafo-Master mit bedarfsabhängigen Hausgrenzen, optionalem dauerhaftem Zählerarchiv und Abrechnungsentwürfen; schneller Austausch mit stabiler Wirkungsbestätigung."
      }
    },
    "title": "NexoWatt EOS",
