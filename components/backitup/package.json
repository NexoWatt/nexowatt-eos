{
  "name": "iobroker.nexowatt-backup",
  "version": "1.0.10",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "NexoWatt EOS Backup creates and restores complete EOS system backups and adds an integrity-checked EOS system profile.",
  "author": {
    "name": "NexoWatt",
    "email": "info@nexowatt.com",
    "url": "https://www.nexowatt.com"
  },
  "contributors": [
    {
      "name": "NexoWatt",
      "email": "info@nexowatt.com"
    },
    {
      "name": "simatec",
      "email": "backitup@simateccloud.de"
    },
    {
      "name": "bluefox",
      "email": "dogafox@gmail.com"
    }
  ],
  "homepage": "https://www.nexowatt.com",
  "license": "MIT",
  "keywords": [
    "NexoWatt",
    "NexoWatt EOS",
    "Energy Operation System",
    "backup",
    "restore",
    "InfluxDB",
    "Redis",
    "CIFS",
    "NFS",
    "FTP",
    "WebDAV",
    "OneDrive",
    "Google Drive",
    "Dropbox"
  ],
  "dependencies": {
    "@esm2cjs/got": "^13.0.0",
    "@googleapis/drive": "^21.0.0",
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/js-controller-common": "^7.2.2",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.7.0",
    "dropbox-v2-api": "^2.5.12",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "ftp": "^0.3.10",
    "google-auth-library": "^11.0.0",
    "mqtt": "^5.15.2",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "node-wol": "^0.1.1",
    "tar-fs": "^3.1.3",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/ftp": "^0.3.36",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/node-schedule": "^2.1.8",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "!admin/**/*.map",
    "!admin/custom/**",
    "admin{,/!(i18n)/**}/flat.txt",
    "docs/de/nexowatt-backup.md",
    "docs/en/nexowatt-backup.md",
    "build/",
    "!build/**/*.map",
    "!CHANGELOG_OLD.md",
    "io-package.json",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "scripts/prepare-publish.cjs",
    "scripts/validate-publish.cjs",
    "release-manifest.json",
    "test/eos-profile.js",
    "test/sd-card.js",
    "test/influxdb-cli.js",
    "test/sd-card-access.js",
    "test/helpers/sd-card-permission-child.cjs"
  ],
  "scripts": {
    "test": "npm run test:package && npm run test:types && npm run test:unit && npm run test:eos-profile && npm run test:sd-card && npm run test:influxdb-cli",
    "test:package": "mocha test/package --exit",
    "test:types": "mocha test/types --exit",
    "test:unit": "mocha test/unit --exit",
    "test:integration": "mocha test/integration --exit",
    "prepublishOnly": "npm run verify:publish",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "translate": "translate-adapter",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-tab && npx -y npm-check-updates --upgrade && cd ../src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-tab && npm i -f && cd ../src-admin && npm i -f",
    "dev-server-run": "dev-server run nexowatt-backup",
    "dev-server-watch": "dev-server watch -x nexowatt-backup",
    "dev-server-upload": "dev-server upload nexowatt-backup",
    "admin-0-clean": "node tasks.js --admin-0-clean",
    "admin-1-npm": "node tasks.js --admin-1-npm",
    "admin-2-compile": "node tasks.js --admin-2-compile",
    "admin-3-copy": "node tasks.js --admin-3-copy",
    "admin-build": "node tasks.js --admin-build",
    "0-clean": "node tasks.js --0-clean",
    "1-npm": "node tasks.js --1-npm",
    "2-build": "node tasks.js --2-build",
    "3-copy": "node tasks.js --3-copy",
    "4-patch": "node tasks.js --4-patch",
    "build:backend": "tsc -p tsconfig.build.json",
    "check-ts": "tsc -p tsconfig.json",
    "build": "npm run verify:publish",
    "lint": "eslint -c eslint.config.mjs",
    "lint-frontend": "cd src-admin && eslint -c eslint.config.mjs && cd ../src-tab && eslint -c eslint.config.mjs",
    "test:eos-profile": "node --test test/eos-profile.js",
    "test:offline": "node --test test/eos-profile.js test/sd-card.js test/influxdb-cli.js test/sd-card-access.js",
    "verify:publish": "npm run prepare:publish && npm run test:offline && node scripts/validate-publish.cjs",
    "build:source": "node tasks.js && npm run build:backend",
    "prepare:publish": "node scripts/prepare-publish.cjs",
    "test:sd-card": "node --test test/sd-card.js test/sd-card-access.js",
    "test:influxdb-cli": "node --test test/influxdb-cli.js"
  },
  "readmeFilename": "README.md",
  "publishConfig": {
    "access": "public"
  }
}
