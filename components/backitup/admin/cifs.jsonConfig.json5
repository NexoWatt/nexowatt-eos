{
    "type": "panel",
    "label": "NAS / SD card / Copy",
    "items": {
        "_header": {
            "type": "header",
            "size": 2,
            "text": "NAS / SD card / Copy",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "connectType": {
            "type": "select",
            "label": "Connection type",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "options": [
                {
                    "label": "SD card",
                    "value": "SDCard"
                },
                {
                    "label": "CIFS",
                    "value": "CIFS"
                },
                {
                    "label": "Copy locally",
                    "value": "Copy"
                },
                {
                    "label": "Expert",
                    "value": "Expert"
                },
                {
                    "label": "NFS",
                    "value": "NFS"
                }
            ],
            "newLine": true
        },
        "_helpLine1": {
            "newLine": true,
            "type": "divider",
            "color": "primary"
        },
        "_sdCardInfo": {
            "hidden": "data.connectType !== 'SDCard'",
            "type": "staticText",
            "text": "Only independently mounted, writable SD cards are listed. The SSD/eMMC system disk is excluded. If the selected SD card is missing, the backup stops without falling back to the system disk.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "sdCardMountPath": {
            "hidden": "data.connectType !== 'SDCard'",
            "type": "selectSendTo",
            "command": "getSdCardTargets",
            "jsonData": "{\"selected\":\"${data.sdCardMountPath}\"}",
            "noTranslation": true,
            "label": "Mounted SD card",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6,
            "validator": "data.sdCardMountPath",
            "validatorNoSaveOnError": true
        },
        "sdCardBackupSubDir": {
            "hidden": "data.connectType !== 'SDCard'",
            "type": "text",
            "label": "Backup directory on SD card",
            "help": "Relative directory below the selected SD-card mount point",
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 6,
            "xl": 6,
            "validator": "data.sdCardBackupSubDir && !data.sdCardBackupSubDir.startsWith('/') && !data.sdCardBackupSubDir.includes('..')",
            "validatorNoSaveOnError": true
        },
        "_testSdCard": {
            "hidden": "data.connectType !== 'SDCard'",
            "newLine": true,
            "variant": "contained",
            "color": "primary",
            "disabled": "!_alive || !data.sdCardMountPath",
            "type": "sendTo",
            "command": "testSdCardTarget",
            "jsonData": "{\"mountPath\":\"${data.sdCardMountPath}\",\"subDir\":\"${data.sdCardBackupSubDir}\"}",
            "label": "Test SD card target",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_sdCardRetentionInfo": {
            "hidden": "data.connectType !== 'SDCard'",
            "type": "staticText",
            "text": "InfluxDB rotation on SD card: the newest 3 backups per configured InfluxDB target are retained. After a successful copy, the oldest generation is deleted automatically.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "cifsMount": {
            "hidden": "data.connectType !== 'NFS' && data.connectType !== 'CIFS'",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "host",
            "help": "IP address or hostname",
            "newLine": true,
            "validator": "data.cifsMount",
            "validatorNoSaveOnError": true
        },
        "cifsDomain": {
            "hidden": "data.connectType !== 'NFS' && data.connectType !== 'CIFS'",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "Domain name (optional)"
        },
        "smbType": {
            "type": "select",
            "hidden": "data.connectType !== 'CIFS'",
            "label": "SMB type",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "options": [
                { "label": "SMB 1.0", "value": "vers=1.0" },
                { "label": "SMB 2.0", "value": "vers=2.0" },
                { "label": "SMB 3.0", "value": "vers=3.0" },
                { "label": "SMB 3.02", "value": "vers=3.02" },
                { "label": "SMB 3.1.1", "value": "vers=3.1.1" }
            ]
        },
        "cifsUser": {
            "hidden": "data.connectType !== 'CIFS'",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "Username",
            "newLine": true,
            "validator": "data.cifsUser",
            "validatorNoSaveOnError": true
        },
        "cifsPassword": {
            "hidden": "data.connectType !== 'CIFS'",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "password",
            "visible": true,
            "label": "Password",
            "validator": "data.cifsPassword",
            "validatorNoSaveOnError": true
        },
        "noserverino": {
            "type": "checkbox",
            "hidden": "data.connectType !== 'CIFS'",
            "label": "Mount with option \"noserverino\"",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2
        },
        "cacheLoose": {
            "type": "checkbox",
            "hidden": "data.connectType !== 'CIFS'",
            "label": "Mount with option \"Cache Loose\"",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2
        },
        "sudoMount": {
            "type": "checkbox",
            "hidden": "data.connectType !== 'NFS' && data.connectType !== 'CIFS'",
            "label": "Mount as root",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "newLine": true
        },
        "cifsDeleteOldBackup": {
            "type": "checkbox",
            "label": "Delete old NAS / SD card / Copy backups",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "newLine": true
        },
        "cifsOwnDir": {
            "hidden": "data.connectType == 'Expert' || data.connectType == 'SDCard'",
            "type": "checkbox",
            "label": "Extra path for backup types",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "wakeOnLAN": {
            "hidden": "data.connectType == 'Copy' || data.connectType == 'SDCard'",
            "type": "checkbox",
            "label": "Wake on LAN",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "macAd": {
            "hidden": "data.connectType == 'Copy' || data.connectType == 'SDCard' || !data.wakeOnLAN",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "MAC address"
        },
        "wolWait": {
            "hidden": "data.connectType == 'Copy' || data.connectType == 'SDCard' || !data.wakeOnLAN",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "min": 0,
            "max": 180,
            "type": "number",
            "label": "seconds",
            "help": "WOL wait time in seconds"
        },
        "wolExtra": {
            "hidden": "data.connectType == 'Copy' || data.connectType == 'SDCard' || !data.wakeOnLAN",
            "type": "checkbox",
            "label": "Wake on LAN advanced settings",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "newLine": true
        },
        "wolPort": {
            "hidden": "data.connectType == 'Copy' || data.connectType == 'SDCard' || !data.wakeOnLAN || !data.wolExtra",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "min": 1,
            "max": 65535,
            "type": "number",
            "label": "Port"
        },
        "cifsMinimalDir": {
            "hidden": "data.connectType == 'Expert' || data.connectType == 'SDCard' || !data.cifsOwnDir",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "Path for NexoWatt EOS backup",
            "newLine": true
        },
        "cifsCcuDir": {
            "hidden": "data.connectType == 'Expert' || data.connectType == 'SDCard' || !data.cifsOwnDir",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "Path for CCU backup"
        },
        "cifsDir": {
            "hidden": "data.connectType == 'Expert' || data.connectType == 'SDCard' || data.cifsOwnDir",
            "xs": 12,
            "sm": 9,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "text",
            "label": "Path",
            "newLine": true
        },
        "expertMount": {
            "hidden": "data.connectType !== 'Expert'",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "type": "text",
            "label": "Mount command (expert)",
            "newLine": true,
            "validator": "data.expertMount",
            "validatorNoSaveOnError": true
        }
    }
}
