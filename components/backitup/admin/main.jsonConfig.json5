{
    "i18n": true,
    "type": "panel",
    "label": "main settings",
    "items": {
        "_header1": {
            "type": "header",
            "text": "What to backup",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "size": 2
        },
        "minimalEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "NexoWatt EOS"
        },
        "ccuEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Homematic CCU"
        },
        "redisEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Redis"
        },
        "javascriptsEnabled": {
            "disabled": "data.hostType === 'Slave'",
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "JavaScripts"
        },
        "zigbee2mqttEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Zigbee2MQTT"
        },
        "zigbeeEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Zigbee Backup"
        },
        "historyEnabled": {
            "newLine": true,
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "History Backup"
        },
        "influxDBEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "InfluxDB Backup"
        },
        "mySqlEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "MySQL Backup"
        },
        "pgSqlEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "PostgreSQL Backup"
        },
        "sqliteEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "SQLite3 backup"
        },
        "grafanaEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Grafana backup"
        },
        "noderedEnabled": {
            "newLine": true,
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Node-Red Backup"
        },
        "yahkaEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Yahka (Homekit) Backup"
        },
        "jarvisEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Jarvis Backup"
        },
        "esphomeEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "ESPHome"
        },
        "_header2": {
            "type": "header",
            "text": "Storage location",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "size": 2
        },
        "cifsEnabled": {
            "newLine": true,
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "NAS / SD card / Copy"
        },
        "ftpEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "FTP"
        },
        "dropboxEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Dropbox"
        },
        "googledriveEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "Google Drive"
        },
        "webdavEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "WebDAV"
        },
        "onedriveEnabled": {
            "type": "checkbox",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 2,
            "xl": 2,
            "label": "OneDrive"
        },
        "_header3": {
            "type": "header",
            "text": "Complete EOS backups may require database tools and credentials. Check InfluxDB and Redis before the first productive backup.",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12,
            "size": 3
        },
        "_helpLink": {
            "type": "staticLink",
            "button": true,
            "variant": "outlined",
            "icon": "info",
            "label": "Show adapter documentation",
            "href": "https://www.nexowatt.com",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_helpLine2": {
            "newLine": true,
            "type": "divider",
            "color": "primary"
        }
    }
}
