[Unit]
Description=NexoWatt EOS independent technical network rollback guard
After=network.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/lib/nexowatt-eos-network/host.py guard
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ReadWritePaths=/run/nexowatt-eos-network /var/lib/nexowatt-eos-network
ReadWritePaths=/proc/sys/net/ipv4/conf /proc/sys/net/ipv6/conf
TimeoutStartSec=45
UMask=0077
MemoryMax=96M
TasksMax=16
LimitCORE=0
