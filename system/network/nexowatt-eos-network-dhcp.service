[Unit]
Description=NexoWatt EOS DHCP on the dedicated technical Ethernet port
# Host bootstrap starts DHCP before sending READY=1; an After= dependency on
# the notifying host service would deadlock that bounded startup operation.
PartOf=nexowatt-eos-network.service
ConditionPathExists=/run/nexowatt-eos-network/dhcp.conf

[Service]
Type=simple
User=eos-network-dhcp
Group=eos-network-dhcp
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --pid-file= --conf-file=/run/nexowatt-eos-network/dhcp.conf
# No automatic hotplug restart: interface identity is rechecked by host control.
Restart=no
StateDirectory=nexowatt-eos-dhcp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX
ReadWritePaths=/var/lib/nexowatt-eos-dhcp
ReadOnlyPaths=/run/nexowatt-eos-network/dhcp.conf
MemoryMax=32M
TasksMax=4
LimitNOFILE=64
LimitCORE=0
TimeoutStopSec=5
