# Design profile, NOT installed or accepted by the dev7/test.2 installer.
# Provision eos-gateway, private credential files, current code and systemd tests first.
[Unit]
Description=NexoWatt EOS extension gateway (development profile)
Requires=nexowatt-eos-postgresql.service
After=nexowatt-eos-postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=eos-gateway
Group=eos-gateway
WorkingDirectory=/opt/nexowatt/eos/current
ExecStart=/usr/bin/node /opt/nexowatt/eos/current/runtime/adapter-channel/main.cjs
ExecReload=/bin/kill -HUP $MAINPID
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSLKEYLOGFILE OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH
Restart=on-failure
RestartSec=10
TimeoutStopSec=12
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/etc/nexowatt-eos/iobroker.json -/etc/nexowatt-eos/postgresql -/var/lib/nexowatt-eos
MemoryHigh=256M
MemoryMax=384M
TasksMax=64
LimitNOFILE=512
LimitCORE=0

[Install]
WantedBy=multi-user.target
