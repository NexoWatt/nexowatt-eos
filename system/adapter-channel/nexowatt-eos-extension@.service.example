# Standalone gateway-aware extension entry point, NOT stock ioBroker.javascript.
# Each instance needs a separate eos-ext-%i user; no shared eos-runtime group.
# Host isolation, BPF enforcement and restart behaviour require target tests.
[Unit]
Description=NexoWatt EOS isolated extension %i (development profile)
Requires=nexowatt-eos-adapter-channel.service
After=nexowatt-eos-adapter-channel.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=eos-ext-%i
Group=eos-ext-%i
WorkingDirectory=/opt/nexowatt/extensions/%i
ExecStart=/usr/bin/node /opt/nexowatt/extensions/%i/main.cjs
LoadCredential=client.key:/etc/nexowatt-eos/extension-credentials/%i/client.key
LoadCredential=client.crt:/etc/nexowatt-eos/extension-credentials/%i/client.crt
LoadCredential=ca.crt:/etc/nexowatt-eos/extension-credentials/%i/ca.crt
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSLKEYLOGFILE OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/etc/nexowatt-eos -/var/lib/nexowatt-eos -/opt/nexowatt/eos/current/app
MemoryHigh=384M
MemoryMax=512M
CPUQuota=50%
TasksMax=48
LimitNOFILE=256
LimitCORE=0

[Install]
WantedBy=multi-user.target
