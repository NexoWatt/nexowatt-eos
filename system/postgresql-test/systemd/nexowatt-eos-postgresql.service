[Unit]
Description=NexoWatt EOS private PostgreSQL test cluster
PartOf=nexowatt-eos.target
Before=nexowatt-eos-controller.service nexowatt-eos-initialize.service nexowatt-eos-upload.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=eos-postgres
Group=eos-postgres
WorkingDirectory=/var/lib/nexowatt-eos/postgresql
RuntimeDirectory=nexowatt-eos-postgresql
RuntimeDirectoryMode=0700
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSLKEYLOGFILE OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH PGOPTIONS PGPASSWORD PGHOST PGSERVICE PGSERVICEFILE
ExecStartPre=/usr/bin/node /opt/nexowatt/eos/current/runtime/release/installed-check.cjs
ExecStart=/usr/lib/postgresql/17/bin/postgres -D /var/lib/nexowatt-eos/postgresql -c config_file=/etc/nexowatt-eos/postgresql/postgresql.conf
ExecStartPost=/usr/bin/node /opt/nexowatt/eos/current/runtime/postgresql/host.cjs wait-server
KillSignal=SIGINT
KillMode=mixed
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/nexowatt-eos/postgresql /run/nexowatt-eos-postgresql
InaccessiblePaths=-/etc/nexowatt-eos/postgresql/authority -/etc/nexowatt-eos/iobroker.json -/var/lib/nexowatt-eos/iobroker-data -/var/lib/nexowatt-eos/home
MemoryHigh=768M
MemoryMax=1G
TasksMax=192
LimitNOFILE=8192
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexowatt-eos-postgresql
