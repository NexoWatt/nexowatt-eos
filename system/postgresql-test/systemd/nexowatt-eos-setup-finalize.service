[Unit]
Description=Commit the validated EOS first-start handoff
Requires=nexowatt-eos-postgresql.service
After=nexowatt-eos-postgresql.service
ConditionPathExists=/var/lib/nexowatt-eos/onboarding/handoff.json
ConditionPathExists=!/etc/nexowatt-eos/first-start-complete.json
StartLimitIntervalSec=300
StartLimitBurst=1

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/nexowatt/eos/current
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSLKEYLOGFILE OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/nexowatt/eos/current/tools/system/finalize-onboarding.cjs
TimeoutStartSec=360
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/etc/nexowatt-eos /var/lib/nexowatt-eos /etc/systemd/system /run/systemd
MemoryHigh=512M
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexowatt-eos-finalize
