[Unit]
Description=NexoWatt EOS fixed first-start license import
Requires=nexowatt-eos-postgresql.service
After=nexowatt-eos-postgresql.service
ConditionPathExists=/var/lib/nexowatt-eos/.initialized
ConditionPathExists=!/etc/nexowatt-eos/first-start-complete.json

[Service]
Type=oneshot
User=eos-runtime
Group=eos-runtime
WorkingDirectory=/opt/nexowatt/eos/current
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED SSLKEYLOGFILE OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH
Environment=NODE_ENV=production
Environment=IOBROKER_DATA_DIR=/var/lib/nexowatt-eos/iobroker-data
ExecStartPre=/usr/bin/node /opt/nexowatt/eos/current/runtime/release/installed-check.cjs
ExecStart=/usr/bin/node /opt/nexowatt/eos/current/runtime/bootstrap/first-start-configuration.cjs --import-license
TimeoutStartSec=45
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/nexowatt-eos/iobroker-data/eos-admin.0/licensing
InaccessiblePaths=-/etc/nexowatt-eos/iobroker.json -/etc/nexowatt-eos/postgresql -/etc/nexowatt-eos/web -/etc/nexowatt-eos/setup-code.txt -/var/lib/nexowatt-eos/postgresql -/var/lib/nexowatt-eos/onboarding
MemoryHigh=128M
MemoryMax=192M
TasksMax=16
LimitNOFILE=128
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexowatt-eos-setup-license
