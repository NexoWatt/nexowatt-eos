[Unit]
Description=NexoWatt EOS PostgreSQL test certificate health (no automatic renewal)
After=nexowatt-eos-postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre=/usr/bin/node /opt/nexowatt/eos/current/runtime/release/installed-check.cjs
ExecStart=/usr/bin/node /opt/nexowatt/eos/current/runtime/postgresql/host.cjs inspect --directory /etc/nexowatt-eos/postgresql
UnsetEnvironment=NODE_OPTIONS NODE_PATH NODE_EXTRA_CA_CERTS NODE_TLS_REJECT_UNAUTHORIZED OPENSSL_CONF OPENSSL_MODULES LD_PRELOAD LD_LIBRARY_PATH
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LimitCORE=0
StandardOutput=journal
StandardError=journal
